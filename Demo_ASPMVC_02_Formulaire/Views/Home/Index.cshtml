@model RegistrationForm
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Demo Formulaire</h1>
    
    <form method="post">
        <div>
            <div>
                @Html.LabelFor(m => m.Name)
                @Html.EditorFor(m => m.Name, new { @class= "form-control" })
            </div>
            <div>
                <label asp-for="Email" for="input-email"> Mail: </label>
                <input asp-for="Email" id="input-email" class="form-control" />
            </div>
            <div>
                <label asp-for="NbPerson" for="input-nbPerson"> Nb Person: </label>
                <input asp-for="NbPerson" id="input-nbPerson" class="form-control" />
            </div>

            <button class="btn btn-warning" type="submit">Envoyer</button>
        </div>
    </form>

</div>
